{
    "name": "rovangju/commie",
    "description": "A simplistic OO wrapper around PHP's built in CSV handling that lets you reference columns by header name",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Justin Rovang",
            "homepage": "http://www.itnobody.com"
        }
    ],
    "keywords": [
        "csv",
        "comma separated value",
        "delimited text"
    ],
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Commie\\": "src/Commie/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Commie\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
